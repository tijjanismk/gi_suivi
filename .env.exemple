# Copier en .env et renseigner. Ce fichier .env n'est jamais commité.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=changer-moi-par-une-chaine-longue-et-aleatoire
ALLOWED_HOSTS=localhost,127.0.0.1,suivi.giconseils.local

# --- Base de données ---
# Développement : base locale. Production : voir docs/exploitation.md.
DATABASE_URL=postgres://gic:gic@localhost:5432/gic

# --- Identité ---
# dev : un utilisateur fictif est injecté par le middleware de développement.
# prod : l'identité vient d'IIS (REMOTE_USER), ces deux lignes sont ignorées.
UTILISATEUR_DEV=GICONSEILS\dev
GROUPES_DEV=GI-Direction

# Groupes AD qui ouvrent les droits (séparés par des virgules)
GROUPE_DIRECTION=GI-Direction
GROUPE_DIRECTION_LECTURE=GI-Direction-Lecture   # consultation seule : voit tout, ne modifie rien
GROUPE_OFFRES=GI-Offres

# --- Fichiers ---
# Racine du partage (module avis, plus tard) ; en dev, un dossier local suffit.
PARTAGE_GIC=\\AD-SERVEUR\GIC

# --- Suivi d'activité ---
SUIVI_RETENTION_MOIS=24
SUIVI_SEUIL_INACTIVITE_S=300
SUIVI_HEURES_PREVUES_SEMAINE=40
