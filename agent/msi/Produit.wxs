<?xml version="1.0" encoding="utf-8"?>
<!--
  MSI de l'agent GI-Suivi (G07), syntaxe WiX 3.
  Construit par ..\construire-msi.ps1 : heat moissonne dist\gisuivi-agent\_internal (groupe FichiersInternes)
  et _pont (groupe FichiersPont, bibliothèques du pont MCP de Claude Desktop, ADR 0016) ; les exécutables et le
  service sont décrits ici à la main.

  UpgradeCode : NE JAMAIS LE CHANGER. C'est lui qui fait qu'une nouvelle version remplace l'ancienne
  (MajorUpgrade) au lieu de s'installer à côté.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="GI-Suivi - agent de poste"
           Language="1036"
           Codepage="1252"
           Version="$(var.Version)"
           Manufacturer="GI-CONSEILS"
           UpgradeCode="C569FFB2-395D-4206-A66A-26AE0D556875">

    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Platform="x64"
             Description="Agent GI-Suivi $(var.Version)" Comments="Mesure le temps actif et le rattache aux dossiers de projet." />

    <MajorUpgrade DowngradeErrorMessage="Une version plus récente de GI-Suivi est déjà installée." />
    <MediaTemplate EmbedCab="yes" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="DossierEditeur" Name="GI-CONSEILS">
          <Directory Id="INSTALLFOLDER" Name="GiSuivi">
            <Directory Id="INTERNAL" Name="_internal" />
            <Directory Id="PONT" Name="_pont" />
          </Directory>
        </Directory>
      </Directory>
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="AgentEtService" Guid="27D4DB6D-07C3-4B72-898D-32E369DB82F2" Win64="yes">
        <File Id="AgentExe" Source="$(var.Source)\gisuivi-agent.exe" KeyPath="yes" />

        <!-- Service de supervision (G06) : même exécutable, argument -service -->
        <ServiceInstall Id="ServiceGiSuivi" Name="GiSuivi"
                        DisplayName="GI-Suivi - supervision de l'agent"
                        Description="Garde l'agent GI-Suivi ouvert dans chaque session (relance s'il est fermé). Ne mesure rien lui-même."
                        Type="ownProcess" Start="auto" Account="LocalSystem" ErrorControl="normal" Vital="yes"
                        Arguments="--service">
          <util:ServiceConfig xmlns:util="http://schemas.microsoft.com/wix/UtilExtension"
                              FirstFailureActionType="restart" SecondFailureActionType="restart" ThirdFailureActionType="restart"
                              RestartServiceDelayInSeconds="10" ResetPeriodInDays="1" />
        </ServiceInstall>
        <ServiceControl Id="ControleGiSuivi" Name="GiSuivi" Start="install" Stop="both" Remove="uninstall" Wait="yes" />

        <!-- Version lisible dans le registre (critère G07). Seule cette valeur est retirée à la
             désinstallation : les autres valeurs de la clé viennent de la GPO. -->
        <RegistryValue Root="HKLM" Key="SOFTWARE\GI-CONSEILS\Suivi" Name="VersionAgent" Type="string" Value="$(var.Version)" />
      </Component>

      <!-- Pont MCP de Claude Desktop (ADR 0016) : programme console lancé par Claude Desktop, jamais par
           le MSI. Le MSI ne touche pas à la configuration de Claude Desktop : chaque personne lance
           pont-mcp.exe avec l'option « claude » dans sa session (LISEZMOI-poste.md). -->
      <Component Id="PontMcp" Guid="01CE427B-07CE-4749-B56C-EAAA3F943A6D" Win64="yes">
        <File Id="PontExe" Source="$(var.Source)\pont-mcp.exe" KeyPath="yes" />
        <File Id="ExempleClaude" Source="$(var.Source)\claude_desktop_config.exemple.json" />
      </Component>
    </DirectoryRef>

    <Feature Id="Agent" Title="Agent GI-Suivi" Level="1">
      <ComponentRef Id="AgentEtService" />
      <ComponentGroupRef Id="FichiersInternes" />
      <ComponentRef Id="PontMcp" />
      <ComponentGroupRef Id="FichiersPont" />
    </Feature>

    <!-- Les agents en cours sont arrêtés avant la mise à jour des fichiers ; le service les relance
         ensuite. Message de fin de session d'abord (l'agent écrit ses segments en attente), arrêt
         forcé seulement s'il n'a pas répondu après le délai. -->
    <util:CloseApplication xmlns:util="http://schemas.microsoft.com/wix/UtilExtension"
                           Id="FermerAgent" Target="gisuivi-agent.exe" EndSessionMessage="yes" CloseMessage="no"
                           Timeout="20" TerminateProcess="1" RebootPrompt="no" />
    <!-- Un pont ouvert (Claude Desktop lancé) verrouillerait pont-mcp.exe : il n'a rien à enregistrer,
         il est arrêté ; Claude Desktop le relance à son prochain démarrage. -->
    <util:CloseApplication xmlns:util="http://schemas.microsoft.com/wix/UtilExtension"
                           Id="FermerPont" Target="pont-mcp.exe" EndSessionMessage="no" CloseMessage="no"
                           Timeout="1" TerminateProcess="1" RebootPrompt="no" />
  </Product>
</Wix>
